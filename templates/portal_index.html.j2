<!DOCTYPE html>
<html lang="zh-HK">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>2026 年度自駕與慢活旅行總門戶 • Travel Portals</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Noto+Sans+TC:wght@400;500;700;900&display=swap');
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: 'Noto Sans TC', sans-serif; background: #faf7f2; color: #332c2b; min-height: 100vh; display: flex; flex-direction: column; align-items: center; padding: 40px 20px; }
.container { max-width: 960px; width: 100%; }
.header { text-align: center; margin-bottom: 36px; }
.brand { font-family: 'Caveat', cursive; font-size: 32px; color: #0f766e; font-weight: 700; }
.title { font-size: 24px; font-weight: 900; margin-top: 4px; }
.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px; }
.card { background: #fff; border: 2px solid #e8dfd2; border-radius: 12px; padding: 24px; box-shadow: 0 4px 16px rgba(0,0,0,0.05); transition: transform 0.2s; }
.card:hover { transform: translateY(-4px); border-color: #0f766e; }
.btn { display: inline-block; background: #0f766e; color: #fff; text-decoration: none; padding: 10px 18px; border-radius: 6px; font-weight: 800; margin-top: 14px; }
</style>
</head>
<body>
<div class="container">
  <div class="header">
    <div class="brand">Travel Portals</div>
    <h1 class="title">2026 年度自駕與慢活旅行手帳總匯</h1>
  </div>
  <div class="grid">
    {% for t in trips %}
    <div class="card">
      <h2>{{ t.title }}</h2>
      <p style="color: #665; margin: 8px 0;">{{ t.dates.summary }}</p>
      <p>{{ t.subtitle }}</p>
      <a href="{{ t.trip_id }}/index.html" class="btn">進入旅行手帳 ＆ 互動地圖 ➔</a>
    </div>
    {% endfor %}
  </div>
</div>
</body>
</html>
